{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chp.dev/schemas/v0.1/capability-definition.schema.json",
  "title": "CapabilityDefinition",
  "description": "A provider-independent semantic capability (proposal 0045, CHP-CAP-001): namespace-authority-owned id + explicit version + optional input/output/effect contracts + declared relationships. Distinct from CapabilityDescriptor (the runtime, provider-coupled descriptor).",
  "type": "object",
  "required": ["id", "version", "namespace", "description"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "namespace": {"type": "object", "required": ["authority"], "additionalProperties": true, "properties": {"authority": {"type": "object", "required": ["id"], "additionalProperties": true, "properties": {"id": {"type": "string", "minLength": 1}}}}},
    "description": {"type": "string"},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "effect": {"type": "object", "additionalProperties": false, "properties": {"class": {"enum": ["advisory", "observational", "attestational", "transactional", "transformative", "physical", "representational", "authoritative"]}}},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["supersedes", "compatible_with", "subtype_of", "equivalent_to", "implements"]},
          "target": {"type": "object", "required": ["id"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}
        }
      }
    }
  }
}

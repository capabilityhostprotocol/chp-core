{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chp.dev/schemas/v0.1/verification-plan.schema.json",
  "title": "VerificationPlan",
  "description": "The projection of evidence still outstanding for a readiness/requirement target (proposal 0044, CHP-RDY-010) - what is missing, acceptable evidence, and completion.",
  "type": "object",
  "required": ["id", "target", "profile", "outstanding", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "target": {"type": "object"},
    "profile": {"type": "object", "required": ["id", "version"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "outstanding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "claim_type", "acceptable_evidence", "completion"],
        "additionalProperties": true,
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "claim_type": {"type": "string", "minLength": 1},
          "acceptable_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "completion": {"type": "string"}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
